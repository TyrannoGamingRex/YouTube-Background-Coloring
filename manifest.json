{
  "manifest_version": 3,
  "name": "YouTube Background Coloring",
  "description": "Changes the background look of YouTube with vibrant gradients and two-tone color themes.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content_script.js"],
      "css": ["styles.css"],
      "run_at": "document_idle"
    }
  ]
}
